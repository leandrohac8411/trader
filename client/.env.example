# Copie para .env.local se precisar. Por padrão o front usa o proxy do Vite (/api -> :4000).
# VITE_API_BASE=            # ex.: http://localhost:4000 para chamar o back-end direto
# VITE_PROXY_TARGET=http://localhost:4000
VITE_ALERT_CONSENSUS=3      # consenso (de 4) para marcar "alerta forte" e notificar
VITE_ALERT_PROB=65         # probabilidade técnica mínima (%) para o mesmo alerta
