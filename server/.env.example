# Copie para .env e preencha. NÃO versione o .env.
PORT=4000
BYBIT_BASE_URL=https://api.bybit.com

# Bybit privado MAINNET — NÃO é usado por nenhum código. Deixe em branco.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─── Bot de forward-test na DEMO TRADING (dinheiro fake, preços reais) ───
# Ligue com DEMO_BOT=1 + as chaves geradas na seção "Demo Trading" da Bybit.
DEMO_BOT=0
BYBIT_DEMO_KEY=
BYBIT_DEMO_SECRET=
BOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
BOT_TIMEFRAMES=60,240
BOT_RISK_PCT=1
BOT_MIN_PROB=85
BOT_REENTRY_COOLDOWN=10
BOT_DAILY_LOSS_LIMIT_PCT=4
BOT_MAX_OPEN=3
BOT_MAX_OPENS_PER_TICK=1
BOT_MAX_NOTIONAL_PCT=0.2   # teto do tamanho da posição = 20% da conta (evita posição gigante)
BOT_LEVERAGE=2
BOT_DRY_RUN=1             # 1 = só registra o que faria; 0 = manda ordem de verdade
BOT_TOKEN=                # opcional: exige header x-bot-token p/ pausar/retomar via API

# CoinMarketCap (sem chave, cai no fallback CoinGecko)
CMC_API_KEY=

# LLM (Groq, API compatível com OpenAI). Sem chave, o comentário de IA vira mock.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Alertas por e-mail (opcional). Precisa de SMTP_* + NOTIFY_TOKEN para habilitar /api/notify/email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TOKEN=

# Consenso mínimo (de 4) para marcar alerta
ALERT_CONSENSUS=3

# Escritório: meta em US$ (demo) e escada de risco 10V/5D aplicada ao bot (opt-in)
OFFICE_GOAL_USD=1000
BOT_LADDER=0
# Escola de traders: 1 = o bot demo usa os parâmetros do aluno promovido (só quando a promoção estiver pronta)
BOT_SCHOOL_PROMOTE=0
